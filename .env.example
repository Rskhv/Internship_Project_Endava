NODE_ENV=development
PORT=3000
POSTGRES_USER=streamify_app
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=streamify
DATABASE_URL=postgresql://streamify_app:replace-with-a-random-local-password@localhost:5432/streamify
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=0
# Optional: uncomment and set before `npm run db:seed` to provision the first admin.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
