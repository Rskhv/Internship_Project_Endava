{
  "name": "streamify-v2",
  "version": "2.0.0",
  "private": true,
  "engines": { "node": ">=20.19" },
  "description": "A simulated streaming service built with React, Express, and PostgreSQL.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch backend/src/server.js",
    "dev:web": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node backend/src/server.js",
    "db:migrate": "node backend/src/utils/migrate.js",
    "db:seed": "node backend/src/utils/seed.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.0",
    "supertest": "^7.1.4",
    "vite": "^7.1.4",
    "vitest": "^5.1.0"
  }
}
